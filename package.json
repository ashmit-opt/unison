{
  "name": "syncaudio",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/server/server.ts",
    "start": "NODE_ENV=production bun src/server/server.ts",
    "build": "bun build ./src/client/index.html --outdir=dist --minify",
    "typecheck": "tsc --noEmit",
    "test": "bun test src tests && node --test tests/opus-decode.node.mjs",
    "check": "tsc --noEmit && bun test src tests && node --test tests/opus-decode.node.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "lucide": "^1.55.0",
    "opus-decoder": "^0.7.12",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/bun": "1.2.6",
    "typescript": "^7.0.2"
  }
}
